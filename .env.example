# Local prototype defaults only. Do not commit a real .env file.
NODE_ENV=development
VITE_AUTH_ENABLED=false

# Production settings are entered in Render Environment, not here.
# Enable auth only after the production identity broker is provisioned.
# VITE_AUTH_ENABLED=true
# BETTER_AUTH_URL=https://your-public-origin.example
# BETTER_AUTH_SECRET=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Supabase PostgreSQL connection string — server-only.
# Copy from Supabase Dashboard > Connect. Use direct or session pooler according
# to the Render network; the URL should require TLS (sslmode=require).
# DATABASE_URL=
