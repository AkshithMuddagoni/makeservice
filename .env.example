# Local prototype defaults only. Do not commit a real .env file.
NODE_ENV=development
VITE_AUTH_ENABLED=false
VITE_PHONE_OTP_ENABLED=false

# Production frontend feature flags are injected at build time via Render.
# VITE_AUTH_ENABLED=true
# VITE_PHONE_OTP_ENABLED=true

# Better Auth session/auth secrets — server-side only.
# BETTER_AUTH_URL=https://makeservice.onrender.com
# BETTER_AUTH_SECRET=

# Optional OAuth broker (not required when using phone OTP only).
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# MSG91 — server-side only. Never prefix these with VITE_.
# Create a transactional Flow template whose approved DLT content contains
# the OTP placeholder VAR1 (or set MSG91_OTP_VARIABLE to your chosen key).
# MSG91_AUTH_KEY=
# MSG91_FLOW_TEMPLATE_ID=
# MSG91_OTP_VARIABLE=VAR1

# Supabase PostgreSQL — server-side only. Copy Shared Pooler / Session mode
# from Supabase Connect for Render (port 5432). Keep sslmode=require.
# DATABASE_URL=
